if(NOT DEFINED DETECT_EXE OR NOT DEFINED SAMPLE_DIR OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Missing test paths")
endif()

file(MAKE_DIRECTORY "${TEST_DIR}")
set(rules_path "${TEST_DIR}/rules.ini")
configure_file("${SAMPLE_DIR}/baseline.ini" "${rules_path}" COPYONLY)
set(existing_output "${TEST_DIR}/existing-alerts.jsonl")
set(new_output "${TEST_DIR}/new-alerts.jsonl")
file(WRITE "${existing_output}" "preserve-existing-alerts\n")
file(REMOVE "${new_output}")
file(SHA256 "${rules_path}" original_rules_hash)
file(SHA256 "${existing_output}" original_output_hash)
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef interface_suffix)
set(missing_interface "cs${interface_suffix}")

function(expect_failure name expected)
    execute_process(COMMAND "${DETECT_EXE}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT result EQUAL 1 OR NOT output STREQUAL "" OR NOT error MATCHES "${expected}")
        message(FATAL_ERROR "${name}: exit=${result}, stdout=${output}, stderr=${error}")
    endif()
    file(SHA256 "${rules_path}" rules_hash)
    file(SHA256 "${existing_output}" output_hash)
    if(NOT rules_hash STREQUAL original_rules_hash OR NOT output_hash STREQUAL original_output_hash)
        message(FATAL_ERROR "${name}: failure changed rules or existing output")
    endif()
    if(EXISTS "${new_output}")
        message(FATAL_ERROR "${name}: failure created a new output")
    endif()
    message(STATUS "PASS ${name}")
endfunction()

set(live_base --rules "${rules_path}" --if "${missing_interface}" --out "${existing_output}")
expect_failure(negative_frames "nonnegative integer" ${live_base} --max-frames -1)
expect_failure(negative_seconds "nonnegative integer" ${live_base} --max-seconds -1)
expect_failure(fractional_seconds "nonnegative integer" ${live_base} --max-seconds 0.5)
expect_failure(seconds_trailing_text "nonnegative integer" ${live_base} --max-seconds 0junk)
expect_failure(frames_trailing_text "nonnegative integer" ${live_base} --max-frames 1junk)
expect_failure(frames_overflow "nonnegative integer" ${live_base} --max-frames 2147483648)
expect_failure(seconds_overflow "nonnegative integer" ${live_base} --max-seconds 999999999999999999999999)
expect_failure(limit_sign_only "nonnegative integer" ${live_base} --max-frames +)
expect_failure(limit_double_sign "nonnegative integer" ${live_base} --max-seconds +-0)
expect_failure(missing_frames_value "nonnegative integer" ${live_base} --max-frames)
expect_failure(missing_seconds_value "nonnegative integer" ${live_base} --max-seconds --max-frames 1)
expect_failure(duplicate_frames_zero "duplicate --max-frames" ${live_base} --max-frames 0 --max-frames 1)
expect_failure(duplicate_seconds_zero "duplicate --max-seconds" ${live_base} --max-seconds 0 --max-seconds 1)
expect_failure(duplicate_interface "duplicate --if" ${live_base} --if another)
expect_failure(duplicate_output "duplicate --out" ${live_base} --out "${new_output}")
expect_failure(duplicate_rules "duplicate --rules" ${live_base} --rules missing.ini)
expect_failure(missing_summary_value "requires a file path" ${live_base} --summary)
expect_failure(unsupported_flag "unsupported option:" ${live_base} --unexpected)
expect_failure(missing_rules "required:" --if "${missing_interface}" --out "${existing_output}" --max-seconds 1)
expect_failure(missing_interface "required:" --rules "${rules_path}" --out "${existing_output}" --max-seconds 1)
expect_failure(missing_output "required:" --rules "${rules_path}" --if "${missing_interface}" --max-seconds 1)
expect_failure(missing_output_value "requires a file path" --rules "${rules_path}" --if "${missing_interface}" --out)
expect_failure(missing_interface_value "requires an interface name" --rules "${rules_path}" --if --out "${existing_output}")
expect_failure(validation_mixed_with_live "cannot be combined" ${live_base} --validate-rules)
expect_failure(check_log_mixed_with_live "cannot be combined" ${live_base} --check-log "${SAMPLE_DIR}/benign.log")
expect_failure(validation_mixed_with_zero_limit "cannot be combined" --rules "${rules_path}" --validate-rules --max-frames 0)
expect_failure(check_log_mixed_with_zero_limit "cannot be combined"
    --rules "${rules_path}" --check-log "${SAMPLE_DIR}/benign.log" --max-seconds 0)
expect_failure(mixed_offline_modes "choose either" --rules "${rules_path}" --validate-rules --check-log "${SAMPLE_DIR}/benign.log")
expect_failure(duplicate_check_log "duplicate --check-log" --rules "${rules_path}" --check-log one --check-log two)
expect_failure(invalid_input_preserves_new_output "nonnegative integer"
    --rules "${rules_path}" --if "${missing_interface}" --out "${new_output}" --max-frames 1junk)

# Rules parsing and alias checks occur before any socket or output file is opened.
file(WRITE "${TEST_DIR}/invalid-rules.ini" "[global]\nwindow_ms=99\n")
expect_failure(invalid_rules_preserve_output "window_ms"
    --rules "${TEST_DIR}/invalid-rules.ini" --if "${missing_interface}" --out "${existing_output}" --max-seconds 1)
expect_failure(missing_rules_file_preserve_output "failed to open baseline"
    --rules "${TEST_DIR}/missing-rules-${interface_suffix}.ini" --if "${missing_interface}" --out "${new_output}" --max-seconds 1)
expect_failure(same_file_alias "must not alias"
    --rules "${rules_path}" --if "${missing_interface}" --out "${rules_path}" --max-seconds 1)
file(MAKE_DIRECTORY "${TEST_DIR}/dotdir")
expect_failure(normalized_path_alias "must not alias"
    --rules "${rules_path}" --if "${missing_interface}" --out "${TEST_DIR}/dotdir/../rules.ini" --max-seconds 1)
file(REMOVE "${TEST_DIR}/rules-hardlink.ini" "${TEST_DIR}/rules-symlink.ini")
file(CREATE_LINK "${rules_path}" "${TEST_DIR}/rules-hardlink.ini" RESULT hardlink_result)
if(hardlink_result STREQUAL "0")
    expect_failure(hardlink_alias "must not alias"
        --rules "${rules_path}" --if "${missing_interface}" --out "${TEST_DIR}/rules-hardlink.ini" --max-seconds 1)
else()
    message(STATUS "SKIP hardlink creation unavailable: ${hardlink_result}")
endif()
file(CREATE_LINK "${rules_path}" "${TEST_DIR}/rules-symlink.ini" SYMBOLIC RESULT symlink_result)
if(symlink_result STREQUAL "0")
    expect_failure(symlink_alias "must not alias"
        --rules "${rules_path}" --if "${missing_interface}" --out "${TEST_DIR}/rules-symlink.ini" --max-seconds 1)
else()
    message(STATUS "SKIP symlink creation unavailable: ${symlink_result}")
endif()

# No configured vcan is required. Valid options reach the platform/interface check.
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    set(startup_error "(socket.*failed|SIOCGIFINDEX.*failed for interface)")
else()
    set(startup_error "Live detection requires Linux")
endif()
expect_failure(default_limits_reach_startup "${startup_error}" ${live_base})
expect_failure(zero_frame_limit_reaches_startup "${startup_error}" ${live_base} --max-frames 0 --max-seconds 1)
expect_failure(zero_second_limit_reaches_startup "${startup_error}" ${live_base} --max-frames 1 --max-seconds 0)
expect_failure(maximum_integer_limit_reaches_startup "${startup_error}" ${live_base} --max-frames 2147483647 --max-seconds 1)
expect_failure(plus_integer_limit_reaches_startup "${startup_error}" ${live_base} --max-frames +1 --max-seconds 1)
expect_failure(startup_failure_preserves_new_output "${startup_error}"
    --rules "${rules_path}" --if "${missing_interface}" --out "${new_output}" --max-seconds 1)
