cmake_minimum_required(VERSION 3.16)
file(MAKE_DIRECTORY "${TEST_DIR}")

function(run_ok name)
    execute_process(COMMAND "${PROFILE_EXE}" ${ARGN}
        WORKING_DIRECTORY "${TEST_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "${name}: ${result}\n${stdout}\n${stderr}")
    endif()
    message(STATUS "PASS: ${name}")
endfunction()

function(run_bad name expected_error)
    execute_process(COMMAND "${PROFILE_EXE}" ${ARGN}
        WORKING_DIRECTORY "${TEST_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result STREQUAL "1" OR NOT stderr MATCHES "${expected_error}")
        message(FATAL_ERROR "${name}: expected exit 1 and '${expected_error}', got ${result}\n${stdout}\n${stderr}")
    endif()
    message(STATUS "PASS: ${name}")
endfunction()

set(sample "# Synthetic CLI fixture, 30 frames at 10 ms intervals\n")
foreach(i RANGE 0 29)
    math(EXPR usec "100000 + ${i} * 10000")
    math(EXPR counter "${i} % 2")
    string(APPEND sample "(1.${usec}) vcan0 100#0${counter}10000000000000\n")
endforeach()
file(WRITE "${TEST_DIR}/benign.log" "${sample}")
file(SHA256 "${TEST_DIR}/benign.log" input_hash)
set(output_args --out "generated results/baseline.ini" --summary "generated results/summary.md")
run_ok("help" --help)
run_ok("generate profile and create output directories" --in benign.log ${output_args})
file(READ "${TEST_DIR}/generated results/baseline.ini" baseline)
file(READ "${TEST_DIR}/generated results/summary.md" summary)
foreach(expected IN ITEMS "benign_source_sha256=${input_hash}" "frame_count=30"
        "periodic=1" "period_min_us=8000" "period_max_us=12000"
        "max_count_per_100ms=10" "rate_limit_100ms=12"
        "fixed_mask=00FFFFFFFFFFFFFF" "max_identical_payload_run=1")
    string(FIND "${baseline}" "${expected}\n" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing expected baseline value: ${expected}")
    endif()
endforeach()
if(NOT summary MATCHES "${input_hash}" OR NOT summary MATCHES "0x100")
    message(FATAL_ERROR "Summary must include source hash and CAN ID")
endif()
message(STATUS "PASS: independent expected values and SHA-256")

file(WRITE "${TEST_DIR}/overrides.ini" "[id:0x100]\nignore_mask=FF00000000000000\nrate_limit_100ms=20\n")
run_ok("apply explicit overrides" --in benign.log ${output_args} --override overrides.ini)
file(READ "${TEST_DIR}/generated results/baseline.ini" overridden)
if(NOT overridden MATCHES "ignore_mask=FF00000000000000" OR NOT overridden MATCHES "rate_limit_100ms=20")
    message(FATAL_ERROR "Overrides did not reach output")
endif()
run_ok("repeat generation with existing outputs" --in benign.log ${output_args})

run_bad("missing required option" "missing required option" --in benign.log)
run_bad("unknown option" "unknown argument" --bogus)
run_bad("duplicate option" "duplicate option" --in benign.log --in benign.log ${output_args})
run_bad("option used as value" "missing value" --in --out baseline.ini --summary summary.md)
run_bad("missing input" "failed to open" --in missing-input.log ${output_args})
file(WRITE "${TEST_DIR}/empty.log" "# No data\n\n")
run_bad("empty input" "empty CAN log" --in empty.log ${output_args})
file(WRITE "${TEST_DIR}/invalid.log" "# Comment\n(1.000000) vcan0 100#123\n")
run_bad("invalid line reports line number" "invalid.log:2:" --in invalid.log ${output_args})
run_bad("input/output alias" "must not overwrite" --in benign.log --out ./benign.log --summary other.md)
run_bad("same output paths" "different output files" --in benign.log --out same.ini --summary ./same.ini)
# Keep alias fixtures fresh on every run, including after a previous failed test.
string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 alias_nonce)
set(alias_dir "fresh-alias-${alias_nonce}")
file(MAKE_DIRECTORY "${TEST_DIR}/${alias_dir}")
run_bad("fresh relative output aliases" "different output files"
    --in benign.log --out "${alias_dir}/same.ini" --summary "./${alias_dir}/same.ini")
if(EXISTS "${TEST_DIR}/${alias_dir}/same.ini")
    message(FATAL_ERROR "Rejected relative aliases left a partial output")
endif()
# Detect the mounted filesystem, not the host OS (WSL may use case-insensitive NTFS).
file(WRITE "${TEST_DIR}/${alias_dir}/probe" "case detection")
if(EXISTS "${TEST_DIR}/${alias_dir}/PROBE")
    run_bad("fresh aliases on case-insensitive filesystem" "different output files"
        --in benign.log --out "${alias_dir}/case.ini" --summary "${alias_dir}/CASE.INI")
    if(EXISTS "${TEST_DIR}/${alias_dir}/case.ini" OR EXISTS "${TEST_DIR}/${alias_dir}/CASE.INI")
        message(FATAL_ERROR "Rejected case aliases left a partial output")
    endif()
endif()
run_bad("summary path cannot become baseline parent" "not a regular file" --in benign.log --out fresh-parent-a/baseline.ini --summary fresh-parent-a)
run_bad("baseline path cannot become summary parent" "not a regular file" --in benign.log --out fresh-parent-b --summary fresh-parent-b/summary.md)
if(EXISTS "${TEST_DIR}/fresh-parent-a/baseline.ini" OR EXISTS "${TEST_DIR}/fresh-parent-b/summary.md")
    message(FATAL_ERROR "Parent/child output conflict created partial results")
endif()
if(WIN32)
    run_bad("case-insensitive fresh output paths" "different output files" --in benign.log --out fresh.ini --summary FRESH.INI)
    run_bad("trailing-dot Windows output alias" "dot or space" --in benign.log --out fresh.ini --summary fresh.ini.)
    run_bad("trailing-space Windows output alias" "dot or space" --in benign.log --out fresh.ini --summary "fresh.ini ")
endif()
string(ASCII 26 ctrl_z)
file(WRITE "${TEST_DIR}/ctrl-z.log" "(1.000000) vcan0 100#00\n${ctrl_z}\n(1.010000) vcan0 100#01\n")
run_bad("embedded Ctrl-Z cannot truncate input silently" "ctrl-z.log:2:" --in ctrl-z.log ${output_args})
file(WRITE "${TEST_DIR}/ctrl-z-override.ini" "[id:0x100]\nrate_limit_100ms=20\n${ctrl_z}\ninvalid=x\n")
run_bad("embedded Ctrl-Z cannot truncate override silently" "profile override" --in benign.log ${output_args} --override ctrl-z-override.ini)
file(MAKE_DIRECTORY "${TEST_DIR}/directory-output")
run_bad("directory output" "not a regular file" --in benign.log --out directory-output --summary other.md)
run_bad("override/output alias" "must not overwrite" --in benign.log --override overrides.ini --out ./overrides.ini --summary other.md)
file(WRITE "${TEST_DIR}/bad-overrides.ini" "[id:0x555]\nrate_limit_100ms=20\n")
run_bad("unknown override ID" "override" --in benign.log ${output_args} --override bad-overrides.ini)
file(SHA256 "${TEST_DIR}/benign.log" final_hash)
if(NOT final_hash STREQUAL input_hash)
    message(FATAL_ERROR "Input was modified")
endif()
file(READ "${TEST_DIR}/generated results/baseline.ini" final_baseline)
if(NOT final_baseline STREQUAL baseline)
    # Only creation time may differ between successful runs.
    string(REGEX REPLACE "created_utc=[^\n]*" "created_utc=CHECKED" before "${baseline}")
    string(REGEX REPLACE "created_utc=[^\n]*" "created_utc=CHECKED" after "${final_baseline}")
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "Failed commands modified the last successful baseline")
    endif()
endif()
message(STATUS "PASS: invalid commands preserve source and existing baseline")
