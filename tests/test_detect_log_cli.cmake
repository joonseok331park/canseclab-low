if(NOT DEFINED DETECT_EXE OR NOT DEFINED SAMPLE_DIR OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Missing test paths")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")

function(run_log_check name rules log expected)
    execute_process(COMMAND "${DETECT_EXE}" --rules "${rules}" --check-log "${log}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT error STREQUAL "" OR NOT output MATCHES "${expected}")
        message(FATAL_ERROR "${name}: exit=${result}, stdout=${output}, stderr=${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
    message(STATUS "PASS ${name}")
endfunction()

function(expect_failure name expected)
    execute_process(COMMAND "${DETECT_EXE}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 1 OR NOT output STREQUAL "" OR NOT error MATCHES "${expected}")
        message(FATAL_ERROR "${name}: exit=${result}, stdout=${output}, stderr=${error}")
    endif()
    message(STATUS "PASS ${name}")
endfunction()

set(sample_rules "${SAMPLE_DIR}/baseline.ini")
run_log_check(benign_sample "${sample_rules}" "${SAMPLE_DIR}/benign.log"
    "Checked 540 frames using UNKNOWN_ID,DLC_MISMATCH,PERIOD_VIOLATION,RATE_SPIKE,FIXED_BYTE_VIOLATION,REPLAY_BURST only; 0 alerts.")

# Use an intentional four-byte policy to distinguish a valid setting from a
# mismatching eight-byte observation, with the saved log parser in the path.
# Preserve the sample's fixed zero tail to isolate DLC from the new fixed rule.
file(READ "${sample_rules}" sample)
string(REPLACE "allowed_dlc=8" "allowed_dlc=4" four_byte_rules "${sample}")
set(rules "${TEST_DIR}/four-byte.ini")
file(WRITE "${rules}" "${four_byte_rules}")
file(WRITE "${TEST_DIR}/normal.log" "(1.000000) vcan0 100#01020304\n")
file(WRITE "${TEST_DIR}/mismatch.log" "(1.000000) vcan0 100#0102030400000000\n")
file(WRITE "${TEST_DIR}/unknown.log" "(1.000000) vcan0 555#01020304\n")
file(WRITE "${TEST_DIR}/extended.log" "(1.000000) vcan0 00000100#01020304\n")
run_log_check(four_byte_match "${rules}" "${TEST_DIR}/normal.log" "only; 0 alerts.")
run_log_check(eight_byte_mismatch "${rules}" "${TEST_DIR}/mismatch.log" "DLC_MISMATCH HIGH")
if(last_output MATCHES "UNKNOWN_ID HIGH")
    message(FATAL_ERROR "Known ID produced wrong alert")
endif()
if(NOT last_output MATCHES "only; 1 alerts.")
    message(FATAL_ERROR "Expected exactly one mismatch")
endif()
run_log_check(unknown_id "${rules}" "${TEST_DIR}/unknown.log" "UNKNOWN_ID HIGH")
if(last_output MATCHES "DLC_MISMATCH HIGH" OR NOT last_output MATCHES "only; 1 alerts.")
    message(FATAL_ERROR "Unknown ID also produced a DLC alert")
endif()
run_log_check(type_is_part_of_identity "${rules}" "${TEST_DIR}/extended.log"
    "UNKNOWN_ID HIGH.*00000100#01020304")

file(WRITE "${TEST_DIR}/empty.log" "# no data frames\n")
file(WRITE "${TEST_DIR}/bad.log" "(1.000000) vcan0 555#01020304\nmalformed\n")
file(SHA256 "${rules}" rules_before)
file(SHA256 "${TEST_DIR}/bad.log" log_before)
expect_failure(empty_log "no CAN frames" --rules "${rules}" --check-log "${TEST_DIR}/empty.log")
expect_failure(malformed_log "bad.log:2:" --rules "${rules}" --check-log "${TEST_DIR}/bad.log")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
expect_failure(missing_log "failed to open" --rules "${rules}" --check-log "${TEST_DIR}/missing-${suffix}.log")
expect_failure(missing_log_path "requires a file path" --rules "${rules}" --check-log)
expect_failure(duplicate_log "duplicate --check-log" --rules "${rules}" --check-log one --check-log two)
expect_failure(conflicting_modes "choose either" --rules "${rules}" --validate-rules --check-log "${TEST_DIR}/normal.log")
file(SHA256 "${rules}" rules_after)
file(SHA256 "${TEST_DIR}/bad.log" log_after)
if(NOT rules_before STREQUAL rules_after OR NOT log_before STREQUAL log_after)
    message(FATAL_ERROR "Log checker modified an input")
endif()

if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND EXISTS "/dev/full")
    foreach(mode IN ITEMS log rules help)
        if(mode STREQUAL "log")
            set(arguments --rules "${rules}" --check-log "${TEST_DIR}/mismatch.log")
        elseif(mode STREQUAL "rules")
            set(arguments --rules "${rules}" --validate-rules)
        else()
            set(arguments --help)
        endif()
        execute_process(COMMAND "${DETECT_EXE}" ${arguments} OUTPUT_FILE "/dev/full"
            RESULT_VARIABLE result ERROR_VARIABLE error)
        if(NOT result EQUAL 1 OR NOT error MATCHES "failed to write standard output")
            message(FATAL_ERROR "${mode} stdout write failure not reported: ${result} ${error}")
        endif()
        message(STATUS "PASS ${mode} stdout write failure")
    endforeach()
endif()
