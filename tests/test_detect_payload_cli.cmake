check_log(zero_length_payload_run "${TEST_DIR}/lengths.ini" "(0.000000) vcan0 100#\n(0.010000) vcan0 100#\n(0.020000) vcan0 100#\n(0.030000) vcan0 100#\n" 1 "REPLAY_BURST HIGH.*identical_payload_run=4 threshold=3")
check_log(fixed_and_run_together "${rules}" "(0.000000) vcan0 100#01220203\n(0.010000) vcan0 100#01220203\n(0.020000) vcan0 100#01220203\n(0.030000) vcan0 100#01220203\n" 5 "REPLAY_BURST HIGH")
check_log(unknown_gets_no_payload_rules "${rules}" "(0.000000) vcan0 555#01220203\n(0.010000) vcan0 555#01220203\n(0.020000) vcan0 555#01220203\n(0.030000) vcan0 555#01220203\n" 4 "UNKNOWN_ID HIGH")
