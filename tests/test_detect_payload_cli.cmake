if(NOT DEFINED DETECT_EXE OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Missing test paths")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")

set(policy "[global]\nwindow_ms=100\n[id:0x100]\nid_type=standard\nallowed_dlc=4\nperiodic=0\nperiod_min_us=0\nperiod_max_us=0\nrate_limit_100ms=1000\nfixed_mask=00FF000000000000\nfixed_value=0010000000000000\nignore_mask=0000000000000000\nmax_identical_payload_run=3\n")
set(rules "${TEST_DIR}/payload.ini")
file(WRITE "${rules}" "${policy}")
string(REPLACE "ignore_mask=0000000000000000" "ignore_mask=00FF000000000000" ignored "${policy}")
file(WRITE "${TEST_DIR}/ignored.ini" "${ignored}")
string(REPLACE "fixed_mask=00FF000000000000" "fixed_mask=00F0000000000000" partial "${policy}")
file(WRITE "${TEST_DIR}/partial.ini" "${partial}")
string(REPLACE "allowed_dlc=4" "allowed_dlc=0,4,5" lengths "${policy}")
file(WRITE "${TEST_DIR}/lengths.ini" "${lengths}")

function(check_log name rules log expected_count expected_rule)
    set(path "${TEST_DIR}/${name}.log")
    file(WRITE "${path}" "${log}")
    file(SHA256 "${path}" before_log)
    file(SHA256 "${rules}" before_rules)
    execute_process(COMMAND "${DETECT_EXE}" --rules "${rules}" --check-log "${path}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT error STREQUAL "" OR
       NOT output MATCHES "FIXED_BYTE_VIOLATION,REPLAY_BURST only; ${expected_count} alerts.")
        message(FATAL_ERROR "${name}: exit=${result}, stdout=${output}, stderr=${error}")
    endif()
    if(NOT expected_rule STREQUAL "" AND NOT output MATCHES "${expected_rule}")
        message(FATAL_ERROR "${name}: expected ${expected_rule}, got ${output}")
    endif()
    file(SHA256 "${path}" after_log)
    file(SHA256 "${rules}" after_rules)
    if(NOT before_log STREQUAL after_log OR NOT before_rules STREQUAL after_rules)
        message(FATAL_ERROR "${name}: input or policy changed")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
    message(STATUS "PASS ${name}")
endfunction()

check_log(fixed_match "${rules}" "(0.000000) vcan0 100#01100203\n" 0 "")
check_log(fixed_change "${rules}" "(0.000000) vcan0 100#01220203\n" 1 "FIXED_BYTE_VIOLATION MEDIUM")
if(NOT last_output MATCHES "index=1 observed=0x22 expected=0x10 effective_mask=0xFF")
    message(FATAL_ERROR "Fixed alert did not explain the changed byte: ${last_output}")
endif()
check_log(unfixed_change "${rules}" "(0.000000) vcan0 100#9910FFFF\n" 0 "")
check_log(ignored_change "${TEST_DIR}/ignored.ini" "(0.000000) vcan0 100#01220203\n" 0 "")
check_log(partial_mask_match "${TEST_DIR}/partial.ini" "(0.000000) vcan0 100#011F0203\n" 0 "")
check_log(partial_mask_change "${TEST_DIR}/partial.ini" "(0.000000) vcan0 100#012F0203\n" 1 "FIXED_BYTE_VIOLATION MEDIUM")
check_log(short_payload_no_missing_byte_comparison "${rules}" "(0.000000) vcan0 100#01\n" 1 "DLC_MISMATCH HIGH")

