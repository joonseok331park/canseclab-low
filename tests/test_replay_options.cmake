if(NOT DEFINED REPLAY_EXE OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Missing test paths")
endif()

file(MAKE_DIRECTORY "${TEST_DIR}")
set(input_path "${TEST_DIR}/normal.log")
set(single_path "${TEST_DIR}/single.log")
file(WRITE "${input_path}" "(1.000000) saved0 100#1234\n(1.010000) saved1 00000100#AB\n")
file(WRITE "${single_path}" "(1.000000) saved0 000#\n")
file(SHA256 "${input_path}" original_hash)
file(SHA256 "${single_path}" original_single_hash)
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef interface_suffix)
set(missing_interface "cs${interface_suffix}")
set(normal_base normal --if "${missing_interface}" --in "${input_path}")

function(expect_failure name expected)
    execute_process(COMMAND "${REPLAY_EXE}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT result EQUAL 1 OR NOT output STREQUAL "" OR NOT error MATCHES "${expected}" OR
       error MATCHES "Replaying normal CAN frames" OR error MATCHES "Sent [0-9]+ frame")
        message(FATAL_ERROR "${name}: exit=${result}, stdout=${output}, stderr=${error}")
    endif()
    file(SHA256 "${input_path}" current_hash)
    file(SHA256 "${single_path}" single_hash)
    if(NOT current_hash STREQUAL original_hash OR NOT single_hash STREQUAL original_single_hash)
        message(FATAL_ERROR "${name}: input file was changed")
    endif()
    message(STATUS "PASS ${name}")
endfunction()

expect_failure(missing_mode "required:")
expect_failure(missing_all_options "required:" normal)
expect_failure(missing_interface "required:" normal --in "${input_path}")
expect_failure(missing_input "required:" normal --if "${missing_interface}")
expect_failure(missing_interface_value "requires an interface name" normal --if --in "${input_path}")
expect_failure(missing_input_value "requires a file path" normal --if "${missing_interface}" --in)
foreach(mode unknown)
    expect_failure(unsupported_${mode} "unsupported replay mode" "${mode}" --if "${missing_interface}" --in "${input_path}")
endforeach()
expect_failure(duplicate_interface "duplicate --if" ${normal_base} --if another)
expect_failure(duplicate_input "duplicate --in" ${normal_base} --in missing.log)
expect_failure(duplicate_speed "duplicate --speed" ${normal_base} --speed 1 --speed 2)
expect_failure(duplicate_loop "duplicate --loop" ${normal_base} --loop 1 --loop 2)
expect_failure(unsupported_option "unsupported option" ${normal_base} --rate 10)
expect_failure(unexpected_mode_suffix "unsupported option" ${normal_base} flood)
expect_failure(missing_speed_value "finite positive decimal number" ${normal_base} --speed)
expect_failure(missing_loop_value "positive uint64 integer" ${normal_base} --loop)
expect_failure(option_as_speed_value "finite positive decimal number" ${normal_base} --speed --loop 1)
expect_failure(option_as_loop_value "positive uint64 integer" ${normal_base} --loop --speed 1)
foreach(speed 0 -0 -1 nan NaN inf infinity 1junk 1.0junk 1e 1e+ . + +-1 0x1p0 1e99999 1e-99999)
    expect_failure(invalid_speed_${speed} "finite positive decimal number" ${normal_base} --speed "${speed}")
endforeach()
expect_failure(speed_leading_space "finite positive decimal number" ${normal_base} --speed " 1")
expect_failure(speed_trailing_space "finite positive decimal number" ${normal_base} --speed "1 ")
foreach(loop 0 -0 -1 0.5 1junk 1e2 + +-1 18446744073709551616 999999999999999999999999)
    expect_failure(invalid_loop_${loop} "positive uint64 integer" ${normal_base} --loop "${loop}")
endforeach()
expect_failure(loop_leading_space "positive uint64 integer" ${normal_base} --loop " 1")
expect_failure(loop_trailing_space "positive uint64 integer" ${normal_base} --loop "1 ")

# The complete log and repeated schedule must be rejected before socket setup,
# even when an earlier frame is valid and the configured interface is absent.
file(WRITE "${TEST_DIR}/empty.log" "")
file(WRITE "${TEST_DIR}/comments.log" "# no frames\n\n")
file(WRITE "${TEST_DIR}/backwards.log" "(2.000000) saved0 100#00\n(1.999999) saved1 200#11\n")
file(WRITE "${TEST_DIR}/late-invalid.log" "(1.000000) saved0 100#00\n(1.010000) saved0 100#000000000000000000\n")
file(WRITE "${TEST_DIR}/full-span.log" "(0.000000) saved0 100#00\n(18446744073709.551615) saved0 100#11\n")
foreach(empty_input empty comments)
    expect_failure(${empty_input}_input "no CAN frames" normal --if "${missing_interface}" --in "${TEST_DIR}/${empty_input}.log")
endforeach()
expect_failure(backwards_input "frame 2: timestamp moves backwards"
    normal --if "${missing_interface}" --in "${TEST_DIR}/backwards.log")
expect_failure(late_invalid_input "late-invalid.log:2:.*8 bytes"
    normal --if "${missing_interface}" --in "${TEST_DIR}/late-invalid.log")
expect_failure(missing_input_file "failed to open CAN log file"
    normal --if "${missing_interface}" --in "${TEST_DIR}/missing-${interface_suffix}.log")
expect_failure(scaled_offset_overflow "timestamp offset" ${normal_base} --speed 1e-300)
expect_failure(total_frame_overflow "total frame count" ${normal_base} --loop 9223372036854775808)
expect_failure(total_duration_overflow "total duration"
    normal --if "${missing_interface}" --in "${TEST_DIR}/full-span.log" --loop 2)

# No actual CAN interface is required for the portable options suite.
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    set(startup_error "(socket.*failed|SIOCGIFINDEX.*failed for interface)")
else()
    set(startup_error "Normal replay requires Linux")
endif()
expect_failure(defaults_reach_startup "${startup_error}" ${normal_base})
expect_failure(speed_double_reaches_startup "${startup_error}" ${normal_base} --speed 2 --loop 3)
expect_failure(speed_half_reaches_startup "${startup_error}" ${normal_base} --speed .5)
expect_failure(speed_exponent_reaches_startup "${startup_error}" ${normal_base} --speed 1e0)
expect_failure(plus_values_reach_startup "${startup_error}" ${normal_base} --speed +1.0 --loop +1)
expect_failure(large_finite_speed_reaches_startup "${startup_error}" ${normal_base} --speed 1e300)
expect_failure(max_loop_one_frame_reaches_startup "${startup_error}"
    normal --if "${missing_interface}" --in "${single_path}" --loop 18446744073709551615)
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    expect_failure(long_interface "interface name must contain 1 to 15 bytes"
        normal --if 1234567890123456 --in "${input_path}")
endif()

foreach(help_mode global normal)
    if(help_mode STREQUAL "global")
        set(help_args --help)
    else()
        set(help_args normal --help)
    endif()
    execute_process(COMMAND "${REPLAY_EXE}" ${help_args}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT result EQUAL 0 OR NOT output STREQUAL "" OR NOT error MATCHES "Usage: cansec-replay normal" OR
       NOT error MATCHES "Normal replay requires Linux")
        message(FATAL_ERROR "${help_mode}_help: exit=${result}, stdout=${output}, stderr=${error}")
    endif()
endforeach()
message(STATUS "PASS normal replay portable options and input validation")
